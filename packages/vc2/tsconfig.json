{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ESNext",  
    "module": "ESNext", 
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "skipLibCheck": true,
    
    /* Bundler mode */
    "moduleResolution": "Bundler", 
                      
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@packages/*": ["packages/*"]
    },     
    "outDir": "./lib",  
    /* Linting */
    "allowJs": true,  
    "checkJs": false,  
    "forceConsistentCasingInFileNames": true,          
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "../../global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "bin",
    "cypress",
    "doc",
    "lib",
    "types",
    "dist",
    "vite.config*"
  ]
}
