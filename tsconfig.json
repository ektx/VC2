{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ektx/vc2": ["packages/vc2/index.ts"],
      "@packages/*": ["packages/vc2/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.d.ts", "packages/**/*.tsx", "packages/**/*.vue", "example/**/*.ts", "example/**/*.d.ts", "example/**/*.tsx", "example/**/*.vue", "*.d.ts"],
  "exclude": ["node_modules", "packages/vc2/lib"]
}