{
  "name": "@ektx/vc2",
  "version": "1.17.4",
  "type": "module",
  "files": [
    "lib",
    "types",
    "global.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "doc": "vipress doc",
    "update": "node --experimental-json-modules ./bin/update.mjs",
    "create": "node ./bin/create.mjs && yarn run update",
    "e2e": "./node_modules/.bin/cypress open",
    "dts": "vue-tsc --declaration --emitDeclarationOnly"
  },
  "main": "lib/cjs/index.cjs",
  "module": "lib/es/index.js",
  "exports": {
    ".": {
      "types": "./lib/es/index.d.ts",
      "import": "./lib/es/index.js",
      "require": "./lib/cjs/index.cjs"
    },
    "./lib/es/index.css": {
      "types": "./lib/es/index.d.ts",
      "import": "./lib/es/index.css",
      "require": "./lib/es/index.css"
    }
  },
  "style": "lib/es/index.css",
  "author": "WenLong",
  "dependencies": {
    "@floating-ui/dom": "^1.7.0",
    "async-validator": "^4.0.7",
    "dayjs": "^1.11.0",
    "vue": "^3.2.37",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/compiler-sfc": "^3.2.37",
    "chokidar": "^4.0.3",
    "fs-extra": "^11.3.0",
    "inquirer": "^7.3.3",
    "less": "^4.1.2",
    "markdown-it": "^14.1.0",
    "markdown-it-for-inline": "^2.0.1",
    "postcss": "^8.4.23",
    "prismjs": "^1.29.0",
    "trash": "^6.1.1",
    "typescript": "^5.3.3",
    "vite": "^6.2.5",
    "vite-plugin-dts": "^4.5.3",
    "vue-tsc": "^1.8.27"
  },
  "license": "MIT"
}
